/**
 * ドメイン定数（ステータス文字列の一元管理・backlog 11-4）
 *
 * 欠員（vacancy）のライフサイクルで使うステータス文字列を1箇所に集約する。
 * 従来はこれらのリテラルがサーバー5ファイル＋HTML3画面に散在しており、
 * 「休講」のような4つ目の決着区分を足すたびに多数のファイルを同時修正する必要があった。
 * サーバー側の判定・分岐はすべてこの定数を参照する（値は従来と完全に同一＝挙動不変）。
 *
 * ※ GAS は全 .gs を単一グローバルに連結する。読み込み順に依存しないよう、
 *    他ファイルのトップレベル定数を「関数の外」で参照しないこと（関数内参照は安全）。
 *    このファイル自身の中での参照（VACANCY_RESULT_VALUES）は宣言順で安全。
 *
 * ※ HTML（manage/home/respond）は、サーバーが返した同じ文字列値を表示・比較している。
 *    値は不変のため画面側の変更は不要。将来テンプレート経由で画面へ渡す場合の唯一の出所もここ。
 */

// スタッフの区分（staffs.role に入る値）。画面のアクセス制御と、マイページで
// 「本人が変更してよい項目」を分ける判定に使う（code.js の doGet / requireStaff_、Profile.gs）。
// ここに置くのは、役割の判定が1つの画面の都合ではなくドメインの区分だから。
const ROLE_STAFF = '職員';

// 欠員の決着結果（vacancies.result に記録する確定値）
const VACANCY_RESULT = {
  FILLED: '補充済',    // 代行者が確定した（先着自動確定 or 職員の手動確定）
  SOLO: '1人テイク',   // 相方が残るので1人で実施（補充できなかった）
  STAFF: '職員対応',   // 誰も残らず職員が対応する
};

// setVacancyResult 等で「妥当な決着値か」を検証するための一覧（宣言順で安全）
const VACANCY_RESULT_VALUES = [VACANCY_RESULT.FILLED, VACANCY_RESULT.SOLO, VACANCY_RESULT.STAFF];

// 時間割ビュー（home）でコマに付ける欠員状況。result 未確定/未発生のときの表示値。
// 決着済みのコマは result 値（VACANCY_RESULT）がそのまま status になる。
const COURSE_VACANCY_STATUS = {
  NORMAL: '通常',        // 欠員なし
  OPEN: '欠員対応中',    // 未解決の欠員がある
};

// 代行依頼への回答（responses.answer に記録する値）
const ANSWER = {
  ACCEPT: '承諾',
  DECLINE: '辞退',
};

// 代行募集がクローズされた理由（notifyRecruitClosed が職員への文面を出し分けるために使う）。
// シートには記録しない（画面と通知の文言を変えるためだけの内部区分）。
//
// ※ D22 以前は「自動決着した理由」だった（AUTO_RESOLVE_REASON）。現在はどの理由であっても
//   システムは result を書かない。書くのは職員（決着）で、システムは募集を閉じるだけ。
const RECRUIT_CLOSE_REASON = {
  NO_CANDIDATES: 'no_candidates',      // その時限に空きのある候補が1人もいなかった（D10）
  PAST_DEADLINE: 'past_deadline',      // 欠勤連絡の時点で既に締切を過ぎていた（直前欠勤・D21）
  DEADLINE_REACHED: 'deadline_reached',// 募集中に締切へ到達した（時間トリガーが検知・D22）
};

// 締め切られた募集へ回答しようとした候補者に見せるメッセージ（respond 画面・D22）。
// 「もう決まった」ではなく「募集の時間が終わった」であることを区別して伝える。
const MSG_RECRUIT_CLOSED =
  'この代行募集は締め切られました（授業開始が近いため）。以降の対応は職員が行います。';

// 決着済みの欠員をさらに決着させようとしたときのユーザー向けメッセージ（職員パス共通）。
// 先着確定と職員操作が競合したときに、黙って上書きせず画面更新を促す（backlog 10-1）。
const MSG_VACANCY_SETTLED =
  'この欠員は既に決着済みです（先着確定など）。画面を更新して最新の状態をご確認ください。';

// 業務のある曜日（シフト入力の選択肢と、空きコマ収集フォームの設問の**単一の出所**・backlog 10-5）。
// かつては Input.gs（INPUT_DAYS＝土あり）と Forms.gs（DAY_QUESTIONS＝土なし）が別々に定義されて
// ドリフトし、土曜コマを登録しても誰も available_slots に「土n」を持てず補充候補が構造的に0人＝
// 毎回「職員対応」に化ける穴があった。両者をこの定数から導出して一致を保証する。
//
// 月〜土（2026-09-12 に '土' を追加）。教職課程など、土曜に授業が入る学生がいるため。
// D17 の時点では「現時点で土曜授業の学生はいない」として月〜金にしていたが、土を恒久的に
// 塞がずこの1定数に集約しておいたのは、まさにこうして1行で開けられるようにするためだった。
// 日曜は入れない（授業が入らないため。必要になればここに足すだけでよい）。
//
// ★ 空きコマ収集フォームを作るとき（未作成・システム完成後に作る予定）の注意：
//   フォームには **WORK_DAYS の全曜日ぶん**の設問を置くこと。設問タイトルは
//   day + WORK_DAY_SLOT_Q_SUFFIX（＝'土曜の空きコマ' など）で、Forms.gs はこの規則で走査する。
//   土曜の設問を落とすと、誰も available_slots に「土n」を持てず**土曜の補充候補が構造的に0人**になる
//   ＝ backlog 10-5 の再発。エラーは出ず「候補なし」として静かに決着待ちへ倒れるので気づきにくい。
//   （フォーム未使用の現在は available_slots を職員が直接入力するため、この穴は開いていない。）
//
// ※ Constants.gs 冒頭の注意どおり、この定数は**関数内から参照**すること
//   （他 .gs のトップレベルで参照すると .gs 連結順に依存して undefined になりうる）。
const WORK_DAYS = ['月', '火', '水', '木', '金', '土'];

// 空きコマ収集フォームの曜日別設問タイトルの接尾辞（day + この文字列 = 設問名）。
// 実フォームの設問名とパーサ（Forms.gs buildSlots_）で共有する唯一の出所。
const WORK_DAY_SLOT_Q_SUFFIX = '曜の空きコマ';

// 学期の切り替わり時期に関する注意書き（時間割・欠勤連絡の両画面で表示する唯一の出所）。
//
// terms シートは1学期につき開始日・終了日を**1組しか持てない**が、実際の学事暦では
// 曜日ごとに切り替わりがずれる（例：学期が水曜始まりなら月・火のコマだけ翌週から次学期／
// GW や祝日の振替で、ある曜日だけ2週間ずれる）。そのため週表示も欠勤日の候補も
// **terms の期間から機械的に導いた目安**にしかならない。
// システム側で祝日や振替を判定するのは（判定材料が増えるほど壊れやすくなるので）行わず、
// 「正はご自身の履修時間割」と明記して人が確認する運用にする。
//
// ※ HTMLテンプレートから <?= TERM_BOUNDARY_NOTICE ?> で参照する（サーバー側で評価される）。
const TERM_BOUNDARY_NOTICE =
  '学期の切り替わり時期は、曜日によって最終週・開始週がずれることがあります。' +
  '実際の授業日は必ずご自身の履修時間割で確認してください。';

// 代行募集の締切（授業開始の何分前か）。この時刻を過ぎた欠勤連絡は「直前欠勤」として扱い、
// 代行候補への依頼を送らずに自動決着させる（submitAbsence・requirements §8）。
//
// この値は**開発者が変更する定数**として置く（職員が運用中に触る想定ではない）。
// 変更するときはこの1箇所を書き換えて clasp push すればよく、既存の未解決欠員にも即反映される
// （締切は欠員行に保存せず、date + periods.start_time から毎回算出しているため）。
//
// ※ Constants.gs 冒頭の注意どおり、この定数は**関数内から参照**すること。
const RECRUIT_DEADLINE_MIN_BEFORE = 30;

// 締切到達を検知する時間トリガーの実行間隔（分）。Triggers.gs の installTriggers が使う。
//
// 締切そのもの（RECRUIT_DEADLINE_MIN_BEFORE＝授業開始30分前）は「いつ閉じるか」で、
// この定数は「閉じたことに何分以内に気づくか」。検知は最大この分数だけ遅れるため、
// 職員が決着を知るのは早くても授業開始の (30 - この値) 分前になる。
// 10分なら授業開始20分前には職員スペースへ届く。
//
// ※ 値を変えたら installTriggers() を再実行してトリガーを作り直すこと
//   （既存のトリガーは古い間隔のまま動き続ける）。
const RECRUIT_DEADLINE_CHECK_INTERVAL_MIN = 10;
